
@using EmployeeTrackingSystem.Models
@model List<staffViewModel>

@{ ViewBag.Title = "Staff List"; }
<style>
    .inactive-row {
        background-color: #B5AFAE !important;
    }
</style>
<div class="container-fluid mt-2">

    @section Buttons {
    <div class="d-flex mb-2">
        <button type="button" id="btnSearch" class="btn_search btn">
            検索
        </button>
        <button type="button" class="btn_Blue btn btn-primary" data-toggle="modal" data-target="#addModal">
            追加
        </button> &nbsp;&nbsp;&nbsp;
        <input type="checkbox" id="chkStaff" />
        <label for="chkStaff">Inactive</label>
    </div>
       
    }

    <!-- TABLE AREA -->
    <div class="table-wrapper table-v-scroll ">
        <table id="tableStaff" class="table table-striped table-hover">
            <thead class="table-dark">
                <tr class="table-header">
                    <th class="th_center">NO</th>
                    <th>スタッフCD</th>
                    <th>スタッフ名</th>
                    <th>部門名</th>
                    <th class="th_center">入社日</th>
                    <th class="th_center">電話番号</th>
                    <th>従業員の種類</th>
                    <th class="th_center">現在のショップ</th>
                    <th class="th_center">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    int no = 1;
                    foreach (var item in Model)
                    {
                <tr class="@(item.Enroll ? "" : "inactive-row")">
                    <td class="text-center">@no</td>
                    <td class="text-left" width="10%">@item.StaffCD</td>
                    <td class="text-left" width="15%">@item.StaffName</td>
                    <td class="text-left" width="20%">
                        @item.DepartmentName
                        <input type="hidden" class="deptCD" value="@item.DepartmentCD" />
                        <input type="hidden" class="email" value="@item.Email" />
                        <input type="hidden" class="remark" value="@item.Remark" />
                        <input type="hidden" class="enroll" value="@item.Enroll.ToString().ToLower()" />
                    </td>
                    <td class="text-center" width="10%">
                        @(item.JoinedDate.HasValue ? item.JoinedDate.Value.ToString("yyyy-MM-dd") : "")
                    </td>
                    <td class="phoneNo text-center" width="10%">@item.PhoneNo</td>
                    <td class="employeetype text-left" width="10%">@item.EmployeeType</td>
                    <td class="text-center" width="10%">@item.CurshopName</td>
                    <td class="text-center" width="10%">
                        <button id="btnChange" class="btn btn-primary">
                            変更
                        </button>
                    </td>
                </tr>
                        no++;
                    }
                }
                else
                {

                }
            </tbody>
        </table>
    </div>


</div>

<!--Update-->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog" style="max-width:400px;">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <div class="modal-title">スタッフ修正</div>
            </div> <!-- Body -->
            <div class="modal-body">
                <form id="editForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="form-container">

                        <div class="form-row">
                            <label>スタッフCD</label>
                            <input type="text" id="StaffCD" name="StaffCD" class="staff-code form-control" readonly />
                            <span class="text-danger" id="errStaffCD"></span>
                        </div>

                        <div class="form-row">
                            <label>スタッフ名</label>
                            <input type="text" id="StaffName" name="StaffName" class="form-control" maxlength="50" />
                            <span class="text-danger" id="errStaffName"></span>
                        </div>

                        <div class="form-row">
                            <label>部門CD</label>
                            @Html.DropDownList("DepartmentCD", ViewBag.Departments as SelectList,
                           new { @class = "DepartmentCD form-control" })

                            <span class="text-danger" id="errDepartmentCD"></span>
                        </div>

                        <div class="form-row">
                            <label>メール</label>
                            <input type="text" name="Email" id="Email" class="form-control" maxlength="30" autocomplete="off" />
                            <span class="text-danger" id="errEmail"></span>
                        </div>

                        <div class="form-row">
                            <label>電話番号</label>
                            <input type="text" name="PhoneNo" id="PhoneNo" class="form-control" maxlength="15" />
                            <span class="text-danger" id="errPhoneNo"></span>
                        </div>

                        <div class="form-row">
                            <label>入社日</label>
                            <div class='input-group date' id='datetimepicker-edit'>
                                <input type="text" name="JoinedDate" class="form-control" id="JoinedDate"  autocomplete="off" />
                                <span class="input-group-addon">
                                    <span class="glyphicon glyphicon-calendar"></span>
                                </span>
                            </div>
                        </div>

                        <div class="form-row">
                            <label>従業員の種類</label>
                            <select name="EmployeeType" class="EmployeeType form-control" id="EmployeeType">
                                <option>Full Time</option>
                                <option>Part Time</option>
                            </select>
                        </div>

                        <div class="form-row">
                            <label>登録済み</label>
                            <div class="radio-group">
                                <label>  <input type="radio" name="Enroll" value="true" checked /> Active</label>
                                <label><input type="radio" name="Enroll" value="false" /> InActive</label>
                            </div>
                        </div>

                        <div class="form-row">
                            <label class="label-remark">備考</label>
                            <textarea name="Remark" id="Remark" class="textarea-remark form-control" maxlength="200" rows="2"></textarea>
                            <span class="text-danger" id="errRemark"></span>
                        </div>


                        <input type="hidden" id="oldDeptCD" name="oldDeptCD" />
                        <!-- Buttons -->
                        <div class="form-actions">
                            <button type="button" class="btn btn-cancel" data-dismiss="modal">取消</button>
                            <button type="submit" class="btn btn-submit">登録</button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ADD-->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog" style="max-width:400px;">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <div class="modal-title">スタッフ追加</div>
            </div> <!-- Body -->
            <div class="modal-body">
                <form id="addForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="form-container">

                        <div class="form-row">
                            <label>スタッフCD</label>
                            <input type="text" name="StaffCD" id="StaffCD" class="form-control staff-code" data-ajax-check="/Staff/CheckStaffCD"
                                   maxlength="5"
                                   autocomplete="off" tabindex="1" />
                            <span class="text-danger" id="errStaffCD"></span>
                        </div>
                        <div class="form-row">
                            <label>スタッフ名</label>
                            <input type="text" name="StaffName" class="form-control" maxlength="50" />
                            <span class="text-danger" id="errStaffName"></span>
                        </div>

                        <div class="form-row">
                            <label>部門CD</label>
                            @Html.DropDownList("DepartmentCD", ViewBag.Departments as SelectList,
                                  new { @class = "form-control" }
                                 )
                            <span class="text-danger" id="errDepartmentCD"></span>
                        </div>

                        <div class="form-row">
                            <label>メール</label>
                            <input type="text" name="Email" class="form-control" data-required="true" data-validate="email" maxlength="30" autocomplete="off" />
                        </div>

                        <div class="form-row">
                            <label>電話番号</label>
                            <input type="text"
                                   name="PhoneNo" class="form-control"
                                   maxlength="15" />
                            <span class="text-danger" id="errPhoneNo"></span>
                        </div>

                        <div class="form-row">
                            <label>入社日</label>
                            <div class='input-group date' id='datetimepicker-add'>
                                <input type="text" name="JoinedDate" class="form-control" id="JoinedDateAdd"  autocomplete="off" />  
                                <span class="input-group-addon">
                                    <span class="glyphicon glyphicon-calendar"></span>
                                </span>
                            </div>
                        </div>
                        <div class="form-row">
                            <label>従業員の種類</label>
                            <select name="EmployeeType" class="form-control">
                                <option>Full Time</option>
                                <option>Part Time</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>登録済み</label>
                            <div class="radio-group">
                                <label>  <input type="radio" name="Enroll" value="true" checked>Active</label>
                                <label>  <input type="radio" name="Enroll" value="false">InActive</label>
                            </div>
                        </div>
                        <div class="form-row">
                            <label class="label-remark">備考</label>
                            <textarea name="Remark" class="textarea-remark form-control" maxlength="200" rows="2"></textarea>
                            <span class="text-danger" id="errRemark"></span>
                        </div>

                        <div class="form-actions">
                            <button type="button" class="btn btn-cancel" data-dismiss="modal">取消</button>
                            <button type="submit" class="btn btn-submit">登録</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Success Message Box -->
<div id="successBox" class="message-box hidden">
    <div class="message-header">成功!</div>
    <div class="message-body" id="successMessage"></div>
    <button class="message-button" onclick="closeSuccessBox()">はい</button>
</div>

<!-- Error Message Box -->
<div id="errorBox" class="message-box hidden">
    <div class="message-header error">エラー!</div>
    <div class="message-body" id="errorMessage"></div>
    <button class="message-button error" onclick="closeErrorBox()">はい</button>
</div>


@section scripts {
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/StaffList.css" />
    <script>
        $(document).ready(function () {
            //common check

            initDatePickers();

            $('#addModal').on('shown.bs.modal', function () {
                $("#addForm [name='StaffCD']").focus();
            });

            $('#editModal').on('shown.bs.modal', function () {
                $("#editForm [name='StaffName']").focus();
            });
            
          
            $('#addForm [name="StaffCD"]').on('input', function () {
                this.value = this.value.replace(/[^A-Za-z0-9-]/g, '');
            });

            $('#addForm [name="PhoneNo"], #editForm [name="PhoneNo"]').on('input', function () {
                let v = this.value;
                v = v.replace(/[^0-9+-]/g, '');   // only valid chars
                v = v.replace(/(?!^)\+/g, '');    // + only first position
                this.value = v.slice(0, 15);
            });

            $('input[maxlength]').on('input', function () {
                let max = this.maxLength;
                if (this.value.length > max) {
                    this.value = this.value.slice(0, max);
                }
            });

            $('textarea[maxlength]').on('input', function () {
                const max = parseInt(this.maxLength);
                let sqlLength = this.value.replace(/\n/g, '\r\n').length;

                while (sqlLength > max) {
                    this.value = this.value.slice(0, -1);
                    sqlLength = this.value.replace(/\n/g, '\r\n').length;
                }
            });

            $("#JoinedDate, #JoinedDateAdd").on("input", function () {
                formatDateInput($(this));
            });

            // =====================
            // Add Form Enter key validation
            // =====================


            $('#addForm input, #addForm select, #addForm textarea').on('keydown', function (e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    if (!$("#errorBox").hasClass("hidden")) return;

                    var $this = $(this);

                    if ($this.attr("name") === "JoinedDate") {

                        if (!validateJoinedDate($this)) {
                            $this.focus();
                            return;
                        }
                    }

                    var fieldName = $this.attr('name');

                    // =====  Check required fields =====

                    // ===== StaffCD duplicate check =====
                    if (fieldName === "StaffCD") {

                        if ($this.val().trim() === "") {

                            $this.addClass("input-error");
                            $this.focus();
                            return;
                        }

                        $.ajax({
                            url: '@Url.Action("CheckStaffCD", "Staff")',
                            type: 'GET',
                            data: { staffCD: $this.val().trim() },

                            success: function (res) {


                                if (res.errorType === "inactive" || res.errorType === "duplicate") {
                                    showError(res.message, $this);
                                    return;
                                }

                                $this.removeClass("input-error");

                                moveToNextFieldAdd($this);
                            }
                        });

                        return;
                    }

                    if (fieldName === "StaffName") {

                        if ($this.val().trim() === "") {

                            $this.addClass("input-error");


                            $this.focus();

                            return;
                        }
                    }
                  
                    // ===== Email validation =====
                    if (fieldName === "Email") {
                        var email = $this.val().trim();

                        if (email !== "") {

                            var regexEmailGmail = /^[a-zA-Z0-9.]+@@gmail\.com$/;

                            if (!regexEmailGmail.test(email)) {


                                $this.addClass("input-error");
                                $this.focus();
                                return;
                            }
                        }
                        $this.removeClass("input-error");
                    }

                    moveToNextFieldAdd($this);
                }
            });


            $(document).on("keydown", "#errorBox .message-button", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    closeErrorBox();
                }
            });
            // ===== Clear error when typing =====
            $('#addForm input, #addForm select, #addForm textarea').on('input', function () {
                if ($(this).val().trim() !== "") {
                    $(this).removeClass("input-error");
                }
            });

            $('#editForm input, #editForm select, #editForm textarea').on('input', function () {
                if ($(this).val().trim() !== "") {
                    $(this).removeClass("input-error");
                }
            });

            // =====================
            // ADD FORM SUBMIT
            // =====================
            $(document).on("submit", "#addForm", function (e) {
                e.preventDefault();
                $("#addForm .input-error").removeClass("input-error");
                $("#addForm .text-danger").text("");
                $.ajax({
                    url: '@Url.Action("Create", "Staff")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            $("#successMessage").text('登録しました。');
                            $("#successBox").removeClass("hidden");
                            $("#addModal").modal('hide');
                        } else if (res.errorType === "inactive") {
                            $("#errorMessage").text(res.message);
                            $("#errorBox").removeClass("hidden");
                            var $field = $("#addForm [name='StaffCD']");
                            $field.addClass("input-error");
                            $field.focus();
                        }
                        else if (res.errorType === "duplicate") {
                            $("#errorMessage").text(res.message);
                            $("#errorBox").removeClass("hidden");
                            var $field = $("#addForm [name='StaffCD']");
                            $field.addClass("input-error");
                            $field.focus();
                        }
                       else if (res.errors) {
                            res.errors.forEach(function (err) {
                                var fieldName = err.field.replace("model.", "");
                                var $field = $("#addForm [name='" + fieldName + "']");
                                $field.addClass("input-error");
                            });
                            var firstError = $("#addForm .input-error").first();
                            if (firstError.length) {
                                firstError.focus();
                            }
                        }
                    },
                    error: function () {
                        console.error("エラーが発生しました");
                    }
                });
            });

            // Add modal cancel
            $(document).on("click", "#addModal .btn-cancel", function () {
                $('#addForm')[0].reset();
                $('.text-danger').text('');
                $("#addForm .input-error").removeClass("input-error");
            });

            // =====================
            // SEARCH
            // =====================
            $(document).on("click", "#btnSearch", function () {
                var dept = $("#department").val();
                var staff = $("#staff").val();
                var chkstaff = $("#chkStaff").is(":checked") ? 1 : 0;
                if (dept.startsWith("S")) {
                    $("#btnUpdateSeat").hide();
                    $("#Seat_tr").hide();
                } else {
                    $("#btnUpdateSeat").show();
                    $("#Seat_tr").show();
                }
                $.ajax({
                    url: '@Url.Action("StaffList", "Staff")',
                    type: 'GET',
                    data: { department: dept, staff: staff, chkstaff: chkstaff },
                    success: function (result) {
                        $("#tableStaff tbody").html($(result).find("#tableStaff tbody").html());
                    },
                    error: function () {
                        // error handling
                    }
                });
            });

            // =====================
            // OPEN EDIT MODAL
            // =====================
            $(document).on("click", "#tableStaff tbody .btn-primary", function () {
                let row = $(this).closest("tr");

                $("#StaffCD").val(row.find("td").eq(0).text().trim());
                $("#StaffName").val(row.find("td").eq(1).text().trim());
                $("#DepartmentCD").val(row.find(".deptCD").val());
                $("#Email").val(row.find(".email").val());
                $("#Remark").val(row.find(".remark").val());

                let joinedText = row.find("td").eq(3).text().trim();
                $("#JoinedDate").val(joinedText ? joinedText.replace(/\//g, "/") : "");
                $("#PhoneNo").val(row.find("td").eq(4).text().trim());
                $("#EmployeeType").val(row.find("td").eq(5).text().trim());
                $("#oldDeptCD").val(row.find(".deptCD").val());

                let shopName = row.find("td").eq(6).text().trim();
                let enrollVal = row.find(".enroll").val();
                $("#editModal input[name='Enroll'][value='" + enrollVal + "']").prop("checked", true);

                $("#editForm [name='CurshopName']").val(shopName);
                $('#editModal').modal('show');

                setTimeout(() => $("#StaffName").focus(), 300);
            });

            // =====================
            // EDIT FORM ENTER KEY
            // =====================
            $('#editForm input, #editForm select, #editForm textarea').on('keydown', function (e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();

                    // Force the datepicker element to close and commit its value immediately



                    $("#editForm .input-error").removeClass("input-error");
                    var $this = $(this);
                    var fieldName = $this.attr('name');
                    if (fieldName === "StaffName") {

                        if ($this.val().trim() === "") {

                            $this.addClass("input-error");
                            $this.focus();

                            return;
                        }
                    }
                    if (fieldName === "Email") {
                        var email = $this.val().trim();

                        if (email !== "") {

                            var regexEmailGmail = /^[a-zA-Z0-9.]+@@gmail\.com$/;

                            if (!regexEmailGmail.test(email)) {


                                $this.addClass("input-error");
                                $this.focus();
                                return;
                            }
                        }
                        $this.removeClass("input-error");
                    }
                    if ($this.attr("name") === "JoinedDate") {

                        if (!validateJoinedDate($this)) {
                            $this.focus();
                            return;
                        }
                    }
                    moveToNextFieldEdit($this);
                }
            });

            $(document).on("submit", "#editForm", function (e) {
                e.preventDefault();
                $("#editForm .input-error").removeClass("input-error");
                $(".text-danger").text("");

                $.ajax({
                    url: '@Url.Action("Update", "Staff")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            $("#successMessage").text('修正しました。');
                            $("#successBox").removeClass("hidden");
                            $("#editModal").modal('hide');
                        } else if (res.errors) {
                            res.errors.forEach(function (err) {
                                var fieldName = err.field.replace("model.", "");
                                var $field = $("#editForm").find("[name='" + fieldName + "'], ." + fieldName);
                                $field.addClass("input-error");
                            });
                            var firstError = $("#editForm .input-error").first();
                            if (firstError.length) {
                                firstError.focus();
                            }
                        }
                    },
                    error: function () {
                        // error handling
                    }
                });
            });

            // Edit modal cancel
            $(document).on("click", "#editModal .btn-cancel", function () {
                $('#editForm')[0].reset();
                $('.text-danger').text('');
                $("#editForm .input-error").removeClass("input-error");
            });

        });

        // =====================
        // DATEPICKER CONFIG
        // =====================
        function initDatePickers() {

            // Initialize the datepicker
            $('#datetimepicker-add').datetimepicker({
                date: new Date(),
                format: 'YYYY-MM-DD',
                showClear: true,
                showClose: true,
                useStrict: true,
                keepInvalid: true
            });

            $('#datetimepicker-edit').datetimepicker({               
                format: 'YYYY-MM-DD',
                showClear: true,
                showClose: true,
                useStrict: true,
                keepInvalid: true,

            });
        }
        function formatDateInput($field) {

            let v = $field.val();

            // keep only numbers
            v = v.replace(/\D/g, '');

            // limit 8 digits
            if (v.length > 8) {
                v = v.substring(0, 8);
            }

            // format only
            if (v.length >= 5 && v.length <= 6) {
                v = v.substring(0, 4) + '-' + v.substring(4);
            }
            else if (v.length >= 7) {
                v = v.substring(0, 4) + '-' +
                    v.substring(4, 6) + '-' +
                    v.substring(6, 8);
            }

            $field.val(v);
        }

        function validateJoinedDate($field) {

            let val = $field.val().trim();

            if (val === "") {
                $field.removeClass("input-error");
                return true;
            }

            // format check
            let regex = /^\d{4}-\d{2}-\d{2}$/;

            if (!regex.test(val)) {
                $field.addClass("input-error");
                return false;
            }

            let [y, m, d] = val.split('-').map(Number);

            let date = new Date(y, m - 1, d);

            // invalid real date check (reject only)
            if (
                date.getFullYear() !== y ||
                date.getMonth() !== m - 1 ||
                date.getDate() !== d
            ) {
                $field.addClass("input-error");
                return false;
            }

            $field.removeClass("input-error");
            return true;
        }
        function moveToNextFieldEdit($current) {
            var $fields = $('#editForm').find('input, select, textarea').filter(':visible');
            var index = $fields.index($current);
            if (index + 1 < $fields.length) {
                $fields.eq(index + 1).focus();
            } else {
                $('#editForm button[type="submit"]').focus();
            }
        }

        function moveToNextFieldAdd($current) {
            var $fields = $('#addForm').find('input, select, textarea').filter(':visible');
            var index = $fields.index($current);
            if (index + 1 < $fields.length) {
                $fields.eq(index + 1).focus();
            } else {
                $('#addForm button[type="submit"]').focus();
            }
        }

        function closeSuccessBox() {
            $("#successBox").addClass("hidden");
            location.reload();
        }

        function closeErrorBox() {
            $("#errorBox").addClass("hidden");
            setTimeout(function () {
                $("#addForm [name='StaffCD']").focus();
                $("#addForm [name='StaffCD']").select();
            }, 50);

        }

        function showError(message, $field) {

            $("#errorMessage").text(message);
            $("#errorBox").removeClass("hidden");

            $field.addClass("input-error");

            setTimeout(function () {
                $("#errorBox .message-button").focus();
            }, 50);
        }



    </script>
}






