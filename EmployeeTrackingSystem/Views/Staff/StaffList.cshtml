
@using EmployeeTrackingSystem.Models
@model List<staffViewModel>

@{ ViewBag.Title = "Staff List"; }
<div class="container-fluid mt-2">

    @section Buttons {
        <div class="d-flex mb-2">
            <button type="button" id="btnSearch" class="btn_search btn">
                検索
            </button>
            <button type="button" class="btn_Blue btn btn-primary" data-toggle="modal" data-target="#addModal">
                追加
            </button>
        </div>
    }

    <!-- TABLE AREA -->
    <div class="table-wrapper table-v-scroll ">
        <table id="tableStaff" class="table table-striped table-hover">
            <thead class="table-dark">
                <tr class="table-header">
                    <th>スタッフCD</th>
                    <th>スタッフ名</th>
                    <th>部門名</th>
                    <th class="th_center">入社日</th>
                    <th class="th_center">電話番号</th>
                    <th>従業員の種類</th>
                    <th class="th_center">現在のショップ</th>
                    <th class="th_center">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                <tr>
                    <td class="text-left" width="10%">@item.StaffCD</td>
                    <td class="text-left" width="15%">@item.StaffName</td>
                    <td class="text-left" width="20%">
                        @item.DepartmentName
                        <input type="hidden" class="deptCD" value="@item.DepartmentCD" />
                        <input type="hidden" class="email" value="@item.Email" />
                        <input type="hidden" class="remark" value="@item.Remark" />
                        <input type="hidden" class="enroll" value="@item.Enroll.ToString().ToLower()" />
                    </td>
                    <td class="text-center" width="10%">
                        @(item.JoinedDate.HasValue ? item.JoinedDate.Value.ToString("yyyy/MM/dd") : "")
                    </td>
                    <td class="phoneNo text-center" width="10%" >@item.PhoneNo</td>
                    <td class="employeetype text-left" width="10%">@item.EmployeeType</td>
                    <td class="text-center" width="10%">@item.CurshopName</td>
                    <td class="text-center" width="10%">
                        <button id="btnChange" class="btn btn-primary">
                            変更
                        </button>
                    </td>
                </tr>
                    }
                }
                else
                {

                }
            </tbody>
        </table>
    </div>

   
</div>

<!--Update-->
<div class="modal fade" id="editModal" tabindex="-1" >
    <div class="modal-dialog" style="max-width:400px;">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <div class="modal-title">スタッフ修正</div>
            </div> <!-- Body -->
            <div class="modal-body">
                <form id="editForm" autocomplete="off" >
                    @Html.AntiForgeryToken()
                    <div class="form-container">

                        <div class="form-row">
                            <label>スタッフCD</label>
                            <input type="text" id="StaffCD" name="StaffCD" class="staff-code" readonly />
                            <span class="text-danger" id="errStaffCD"></span>
                        </div>

                        <div class="form-row">
                            <label>スタッフ名</label>
                            <input type="text" id="StaffName" name="StaffName"  maxlength="50" />
                            <span class="text-danger" id="errStaffName"></span>
                        </div>

                        <div class="form-row">
                            <label>部門CD</label>
                            @Html.DropDownList("DepartmentCD", ViewBag.Departments as SelectList, new { @class = "DepartmentCD" })
                            @*//form-control*@

                            <span class="text-danger" id="errDepartmentCD"></span>
                        </div>

                        <div class="form-row">
                            <label>メール</label>
                            <input type="text" name="Email" id="Email" maxlength="30" autocomplete="off" />
                            <span class="text-danger" id="errEmail"></span>
                        </div>

                        <div class="form-row">
                            <label>電話番号</label>
                            <input type="text" name="PhoneNo" id="PhoneNo" maxlength="15" />
                            <span class="text-danger" id="errPhoneNo"></span>
                        </div>

                        <div class="form-row">
                            <label>入社日</label>
                            <div class="date-wrapper">
                                <input type="text" id="JoinedDate" name="JoinedDate" placeholder="yyyy/MM/dd" autocomplete="off" />
                            </div>
                        </div>

                        <div class="form-row">
                            <label>従業員の種類</label>
                            <select name="EmployeeType" class="EmployeeType" id="EmployeeType">
                                <option>Full Time</option>
                                <option>Part Time</option>
                            </select>
                        </div>

                        <div class="form-row">
                            <label>登録済み</label>
                            <div class="radio-group">
                                <label>  <input type="radio" name="Enroll" value="true" checked /> Active</label>
                                <label><input type="radio" name="Enroll" value="false" /> InActive</label>
                            </div>
                        </div>

                        <div class="form-row">
                            <label class="label-remark">備考</label>
                            <textarea name="Remark" id="Remark" class="textarea-remark"  maxlength="200" rows="2"></textarea>
                            <span class="text-danger" id="errRemark"></span>
                        </div>

                        <div class="form-row" style="display:none;">
                            <label class="seat-label">席番号</label>
                            <input type="text" id="SeatNo" name="SeatNo" class="short-input" maxlength="2"
                                   oncompositionstart="this.c=1"
                                   oncompositionend="this.c=0;this.oninput()"
                                   oninput="
                                           if(this.c) return;
                                           this.value = this.value.replace(/\D/g,'').replace(/^0+/, '').slice(0,2);
                                         " />
                            <input type="hidden" name="OriginalSeatNo" />
                            <input type="hidden" name="CurshopName" />
                        </div>

                        <!-- Buttons -->
                        <div class="form-actions">
                            <button type="button" class="btn-cancel" data-dismiss="modal">取消</button>
                            <button type="submit" class="btn-submit">修正</button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ADD-->
<div class="modal fade" id="addModal" tabindex="-1"  >
    <div class="modal-dialog" style="max-width:400px;">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <div class="modal-title">スタッフ追加</div>
            </div> <!-- Body -->
            <div class="modal-body">
                <form id="addForm" autocomplete="off" >
                    @Html.AntiForgeryToken()
                    <div class="form-container">

                        <div class="form-row">
                            <label>スタッフCD</label>
                            <input type="text" name="StaffCD" id="StaffCD" class="staff-new-code"  data-ajax-check="/Staff/CheckStaffCD" 
                                   maxlength="5"
                                    
                                   autocomplete="off" tabindex="1" />
                            <span class="text-danger" id="errStaffCD"></span>
                        </div>
                        <div class="form-row">
                            <label>スタッフ名</label>
                            <input type="text" name="StaffName" maxlength="50" />
                            <span class="text-danger" id="errStaffName"></span>
                        </div>

                        <div class="form-row">
                            <label>部門CD</label>
                            @Html.DropDownList("DepartmentCD", ViewBag.Departments as SelectList)
                            @*,
                                new { @class = "form-control" }))*@
                            <span class="text-danger" id="errDepartmentCD"></span>
                        </div>

                        <div class="form-row">
                            <label>メール</label>
                            <input type="text" name="Email" data-required="true" data-validate="email" maxlength="30" autocomplete="off"  />
                            <span class="text-danger" id="errEmail"></span>
                        </div>

                        <div class="form-row">
                            <label>電話番号</label>
                            <input type="text"
                                   name="PhoneNo"
                                   maxlength="15"
                                   />
                            <span class="text-danger" id="errPhoneNo"  ></span>
                        </div>

                        <div class="form-row">
                            <label>入社日</label>
                            <div class="date-wrapper">
                                <input type="text" name="JoinedDate" id="JoinedDateAdd" placeholder="yyyy/MM/dd" autocomplete="off" />
                            </div>
                        </div>
                        <div class="form-row">
                            <label>従業員の種類</label>
                            <select name="EmployeeType">
                                <option>Full Time</option>
                                <option>Part Time</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>登録済み</label>
                            <div class="radio-group">
                                <label>  <input type="radio" name="Enroll" value="true" checked>Active</label>
                                <label>  <input type="radio" name="Enroll" value="false">InActive</label>
                            </div>
                        </div>
                        <div class="form-row">
                            <label class="label-remark">備考</label>
                            <textarea name="Remark" class="textarea-remark" maxlength="200" rows="2"></textarea>
                            <span class="text-danger" id="errRemark"></span>
                        </div>
                        <div class="form-row" style="display:none;">
                            <label>席番号</label>
                            <input type="text" name="SeatNo" class="short-input"
                                   maxlength="2"
                                   oncompositionstart="this.c=1"
                                   oncompositionend="this.c=0;this.oninput()"
                                   oninput="
                                           if(this.c) return;
                                           this.value = this.value.replace(/\D/g,'').replace(/^0+/, '').slice(0,2);" />

                            <span class="text-danger" id="errSeatNo"></span>
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn-cancel" data-dismiss="modal">取消</button>
                            <button type="submit" class="btn-submit">登録</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="~/Content/StaffList.css" />
    <script>
        $(document).ready(function () {
    //common check 
    $('#department').select2();
    $('#staff').select2();
            initDatePickers();

            $('#addModal').on('shown.bs.modal', function () {

                $("#addForm [name='StaffCD']").focus();
            });

            $('#editModal').on('shown.bs.modal', function () {
               
                $("#editForm [name='StaffName']").focus();
            });

            $('#addForm [name="StaffCD"]').on('input', function () {
                this.value = this.value.replace(/[^A-Za-z0-9-]/g, '');
                
            });
            $('#addForm [name="PhoneNo"], #editForm [name="PhoneNo"]').on('input', function () {
                let v = this.value;

                v = v.replace(/[^0-9+-]/g, '');   // only valid chars
                v = v.replace(/(?!^)\+/g, '');    // + only first position

                this.value = v.slice(0, 15);
            });
          
            $('input[maxlength]').on('input', function () {
                let max = this.maxLength;

                if (this.value.length > max) {
                    this.value = this.value.slice(0, max);
                }

            });

            $('textarea[maxlength]').on('input', function () {

                const max = parseInt(this.maxLength);
                let sqlLength = this.value.replace(/\n/g, '\r\n').length;

                while (sqlLength > max) {

                    this.value = this.value.slice(0, -1);

                    sqlLength = this.value.replace(/\n/g, '\r\n').length;
                }
            });
    // =====================
    // Add Form Enter key validation
    // =====================


    var requiredFields = ["StaffCD", "StaffName", "DepartmentCD"];

    $('#addForm input, #addForm select, #addForm textarea').on('keypress', function (e) {
        if (e.which === 13) { // Enter key
            e.preventDefault();
            $("#addForm .input-error").removeClass("input-error");
            var $this = $(this);
            var fieldName = $this.attr('name');

            // =====  Check required fields =====
            requiredFields.forEach(function (name) {
                var value = $("#addForm [name='" + name + "']").val().trim();
                if (value === "") {
                    $("#addForm #err" + name).text("*");

                } else {
                    $("#addForm #err" + name).text(""); // clear if filled
                }
            });
            // ===== StaffCD duplicate check =====

            if (fieldName === "StaffCD") {
                var staffCD = $this.val().trim();
                if (staffCD !== "") {
                    $.ajax({
                        url: '@Url.Action("CheckStaffCD", "Staff")',
                        type: 'GET',
                        data: { staffCD: staffCD },
                        success: function (res) {
                            if (res.errorType === "inactive") {
                                alert(res.message);
                                $this.addClass("input-error");
                                return;
                            }

                            //  duplicate case
                            if (res.exists) {
                                $this.addClass("input-error");
                            }

                            //  valid case
                            else {
                                $this.removeClass("input-error");
                                moveToNextFieldAdd($this);
                            }
                        },
                        error: function () {
                            console.error("Error checking StaffCD");
                        }
                    });
                    return; 
                } else {
                    return; 
                }
            }
            // =====  Move to next field if no error =====
            moveToNextFieldAdd($this);
        }
    });

    // ===== Clear error when typing =====
    $('#addForm input, #addForm select, #addForm textarea').on('input', function () {
        if ($(this).val().trim() !== "") {
            $(this).removeClass("input-error");
        }
    });
    $('#editForm input, #editForm select, #editForm textarea').on('input', function () {
                if ($(this).val().trim() !== "") {
                    $(this).removeClass("input-error");
                }
            });

    // =====================
    // ADD FORM
    // =====================

    $(document).on("submit", "#addForm", function (e) {
        e.preventDefault();
        //clear previous errors
        $("#addForm .input-error").removeClass("input-error");
        $("#addForm .text-danger").text("");
        $.ajax({
            url: '@Url.Action("Create", "Staff")',
            type: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                if (res.success) {
                    alert("登録成功しました");
                    $("#addModal").modal('hide');
                    location.reload();
                } else if (res.errorType === "inactive") {
                   
                    alert(res.message);
                    var $field = $("#addForm [name='StaffCD']");
                    $field.addClass("input-error");
                    $field.focus();
                }
                else if (res.errors) {
                    res.errors.forEach(function (err) {
                        var fieldName = err.field.replace("model.", "");
                        var $field = $("#addForm [name='" + fieldName + "']");
                        $field.addClass("input-error");
                    });
                    //  focus first error field
                    var firstError = $("#addForm .input-error").first();
                    if (firstError.length) {
                        firstError.focus();
                    }
                }
            },
            error: function () {
                console.error("エラーが発生しました");
            }
        });
        });

    // Add modal cancel
    $(document).on("click", "#addModal .btn-cancel", function () {
        $('#addForm')[0].reset();
        $('.text-danger').text('');
        $("#addForm .input-error").removeClass("input-error");
    });
    // =====================
    // SEARCH
    // =====================
    $(document).on("click", "#btnSearch", function () {
        var dept = $("#department").val();
        var staff = $("#staff").val();
        if (dept.startsWith("S")) {
            $("#btnUpdateSeat").hide();
            $("#Seat_tr").hide();
        }
        else {
            $("#btnUpdateSeat").show();
            $("#Seat_tr").show();
        }
        $.ajax({
            url: '@Url.Action("StaffList", "Staff")',
            type: 'GET',
            data: { department: dept, staff: staff },
            success: function (result) {
                $("#tableStaff tbody").html($(result).find("#tableStaff tbody").html());
               
            },
            error: function () {
               // alert("Error loading data");
            }
        });
    });
    // =====================
    // OPEN EDIT MODAL
    // =====================
    $(document).on("click", "#tableStaff tbody .btn-primary", function () {

        let row = $(this).closest("tr");

        $("#StaffCD").val(row.find("td").eq(0).text().trim());
        $("#StaffName").val(row.find("td").eq(1).text().trim());
        $("#DepartmentCD").val(row.find(".deptCD").val());
        $("#Email").val(row.find(".email").val());
       
        $("#Remark").val(row.find(".remark").val());
        

        let joinedText = row.find("td").eq(3).text().trim();
        $("#JoinedDate").val(joinedText ? joinedText.replace(/\//g, "/") : "");
        $("#PhoneNo").val(row.find("td").eq(4).text().trim());
        $("#EmployeeType").val(row.find("td").eq(5).text().trim());

       
        
        let shopName = row.find("td").eq(6).text().trim();

        let enrollVal = row.find(".enroll").val();
        $("#editModal input[name='Enroll'][value='" + enrollVal + "']").prop("checked", true);


       
        $("#editForm [name='CurshopName']").val(shopName);
        $('#editModal').modal('show');

        setTimeout(() => $("#StaffName").focus(), 300);
    });
    // =====================
    // EDIT FORM
    // =====================

    $('#editForm input, #editForm select, #editForm textarea').on('keypress', function (e) {
        if (e.which === 13) { // Enter key
            e.preventDefault();
            $("#editForm .input-error").removeClass("input-error");
            var $this = $(this);

            moveToNextFieldEdit($this);
        }
    });
    $(document).on("submit", "#editForm", function (e) {
        e.preventDefault();
        $("#editForm .input-error").removeClass("input-error");
        $(".text-danger").text("");

        $.ajax({
            url: '@Url.Action("Update", "Staff")',
            type: 'POST',
            data: $(this).serialize(),
            success: function (res) {
                if (res.success) {

                    alert("登録成功しました");
                    $("#editModal").modal('hide');
                    location.reload();

                }
                else if (res.errors) {

                    res.errors.forEach(function (err) {
                        var fieldName = err.field.replace("model.", "");
                        var $field = $("#editForm").find("[name='" + fieldName + "'], ." + fieldName);
                        $field.addClass("input-error");
                        console.log(fieldName);
                        console.log($field.length);
                    });
                    var firstError = $("#editForm .input-error").first();
                    if (firstError.length) {
                        firstError.focus();
                    }
                }
            },
            error: function () {
                //alert("エラーが発生しました");
            }
        });
        });


    // Edit modal cancel
    $(document).on("click", "#editModal .btn-cancel", function () {
        $('#editForm')[0].reset();
        $('.text-danger').text('');
        $("#editForm .input-error").removeClass("input-error");
    });

    });


    // =====================
    // DATEPICKER: Add & Edit
    // =====================
        function initDatePickers() {

            $("#JoinedDate, #JoinedDateAdd").datepicker({
                dateFormat: "yy/mm/dd"
            });

            // prevent invalid characters
            $("#JoinedDate, #JoinedDateAdd").on("input", function () {
                this.value = this.value.replace(/[^0-9\/]/g, '');
            });


            // default today for Add
            if (!$("#JoinedDateAdd").val()) {
                $("#JoinedDateAdd").val($.datepicker.formatDate('yy/mm/dd', new Date()));
            }
        }
      
    function moveToNextFieldEdit($current) {
        var $fields = $('#editForm').find('input, select, textarea').filter(':visible');
        var index = $fields.index($current);
        if (index + 1 < $fields.length) {
            $fields.eq(index + 1).focus();
        } else {
            $('#editForm button[type="submit"]').focus();
        }
    }

    // ===== Helper to move focus =====
    function moveToNextFieldAdd($current) {
        var $fields = $('#addForm').find('input, select, textarea').filter(':visible');
        var index = $fields.index($current);
        if (index + 1 < $fields.length) {
            $fields.eq(index + 1).focus();
        } else {
            $('#addForm button[type="submit"]').focus();
        }
    }
       
    </script>
}






