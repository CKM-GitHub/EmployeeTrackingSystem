        function formatDate(dt) {
            if (!dt) return "";
            return dt.replace("T", " ").substring(0, 16);
        }

        function initGlobalDragDrop() {
            $(document).off('dragstart dragend dragover dragleave drop', '.staff-slot, .department-area');

            var draggedItem = null;
            $(document).on('dragstart', '.staff-slot', function (ev) {
                ev.stopPropagation();

                var staffCd = $(this).attr('data-staffcd');

                if (!staffCd) {
                    ev.preventDefault();
                    return;
                }

                draggedItem = this;
                ev.originalEvent.dataTransfer.setData("text/plain", staffCd);

                $('.staff-slot').removeClass('is-dragging');
                $(this).addClass('is-dragging');
            });

            $(document).on('dragend', '.staff-slot', function () {
                $(this).removeClass('is-dragging');
                $('.staff-slot, .department-area').removeClass('drag-over');
            });

            $(document).on('dragover', '.staff-slot, .department-area', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $(this).addClass('drag-over');
            });

            $(document).on('dragleave', '.staff-slot, .department-area', function (e) {
                e.stopPropagation();
                $(this).removeClass('drag-over');
            });

            $(document).on('drop', '.staff-slot, .department-area', function (ev) {
                ev.preventDefault();
                ev.stopPropagation();

                $('.staff-slot, .department-area').removeClass('drag-over');

                if (!draggedItem) return;


                var dropTarget = $(ev.target);

                // (SWAP LOGIC check)
                var targetStaffSlot = dropTarget.closest('.staff-slot');

                // 🚨 Staff Code あれば -> SWAP
                if (targetStaffSlot.length > 0 && targetStaffSlot.attr('data-staffcd') && targetStaffSlot[0] !== draggedItem) {

            let targetItem = targetStaffSlot[0];

            let draggedSeat = $(draggedItem).data('seat');
            let targetSeat = $(targetItem).data('seat');
            let draggedStaff = $(draggedItem).data('staffcd');
            let targetStaff = $(targetItem).data('staffcd');
            let draggedDept = $(draggedItem).data('dept');
            let targetDept = $(targetItem).data('dept');

            if (!draggedDept || !targetDept) {
                return;
            }
            if ((draggedDept.startsWith("S") && !targetDept.startsWith("S")) || (!draggedDept.startsWith("S") && targetDept.startsWith("S"))) {
                $("#errorMessage").text("動きはできません。");
                $("#errorBox").removeClass("hidden");
                return;
            }


            // HTML Elements　change
            let draggedClone = $(draggedItem).clone(false);
            let targetClone = $(targetItem).clone(false);
            $(draggedClone).removeClass('is-dragging drag-over');
            $(targetClone).removeClass('is-dragging drag-over');

            $(draggedItem).replaceWith(targetClone);
            $(targetItem).replaceWith(draggedClone);

            // Database Update
            if (typeof saveSeatChange === "function") {
                saveSeatChange(draggedStaff, targetSeat, targetStaff, draggedSeat, draggedDept, targetDept);
            }
        }
                // 🚨  MOVE Process
                else {
                    var targetDeptArea = dropTarget.closest('.department-area');
                    var newDeptCd = targetDeptArea.attr('data-deptCD');
                    let staffCd = $(draggedItem).data("staffcd");
                    var oldDeptCd = $(draggedItem).data('dept');

                    if (!staffCd || !newDeptCd || !oldDeptCd) return;
                    if ((oldDeptCd.startsWith("S") && !newDeptCd.startsWith("S")) || (!oldDeptCd.startsWith("S") && newDeptCd.startsWith("S"))) {
                $("#errorMessage").text("動きはできません。");
                return;
            }
                    if (oldDeptCd === newDeptCd) return;

                    // Database Update
                    $.ajax({
                        url: '@Url.Action("ChangeDepartment", "Home")',
                        type: 'POST',
                        data: {
                    staffCd: staffCd,
                    draggedDept: oldDeptCd,
                    targetDept: newDeptCd
                },
                        success: function (response) {
                    if (response.success) {
                        // Dynamic HTML Refresh
                        refreshDepartmentTable(oldDeptCd);
                        refreshDepartmentTable(newDeptCd);
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                        error: function() {
                    alert("Error!");
                }
                    });
                }
            });
        }


         function refreshDepartmentTable(deptCd) {
            $.ajax({
          url: '@Url.Action("GetRefreshDepartment", "Home")',
            type: 'GET',
            data: { departmentCd: deptCd },
            success: function (htmlResult) {
                $('#dept-container-' + deptCd).html(htmlResult);
            },
            error: function () {
                console.log("Error:" + deptCd + " is not ok to refresh!");
            }
        });
        }


        function saveSeatChange(staff1, seat1, staff2, seat2, dept1, dept2) {
            $.ajax({
                url: '@Url.Action("UpdateSeatChange", "Home")',
                type: 'POST',
                data: {
                    staff1: staff1,
                    seat1: seat1,
                    staff2: staff2,
                    seat2: seat2,
                    dept1: dept1,
                    dept2: dept2
                },
                success: function (res) {
                    // Dynamic HTML Refresh
                    if ($("#departmentDropdown").val() == null) {
                        refreshDepartmentTable(dept1);
                        refreshDepartmentTable(dept2);
                    }

                },
                error: function () {
                    $("#errorMessage").text("Save failed");
                    $("#errorBox").removeClass("hidden");

                }
            });
        }
