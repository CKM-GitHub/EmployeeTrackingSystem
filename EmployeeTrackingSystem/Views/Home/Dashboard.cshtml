
@using EmployeeTrackingSystem.Models
@{
    ViewBag.Title = "Dashboard";
}
<div class="container-fluid py-3">
    <div class="row align-items-center mb-12 d-flex flex-wrap" id="dashboard_header">
        <div class="col-12 col-xs-12 col-sm-6 col-md-3 sts">
            <div class="main-title-bar text-center text-md-start">
                @ViewBag.CurDate の出席状況概要
            </div>
        </div>

        <div class="col-12 col-xs-12 col-sm-6 col-md-8 sts">
            <div class="status-legend">
                <div class="status-item">
                    <span class="dot at-desk"></span>
                    <span class="label">在席</span>
                </div>
                <div class="status-item">
                    <span class="dot left-office"></span>
                    <span class="label">帰宅</span>
                </div>
                <div class="status-item">
                    <span class="dot out-of-office"></span>
                    <span class="label">外出／直行</span>
                </div>
                <div class="status-item">
                    <span class="dot in-meeting"></span>
                    <span class="label">会議</span>
                </div>
                <div class="status-item">
                    <span class="dot day-off"></span>
                    <span class="label">休み</span>
                </div>
                <div class="tablet-mobile-only">
                    @Html.DropDownList(
                        "SelectedDepartment",
                        new SelectList(Model.Alldepartments, "DepartmentCD", "DepartmentName"),
                        "-- Select Department --",
                        new { @class = "form-control", @id = "departmentDropdown" }
                    )
                </div>
            </div>
        </div>


    </div>

    @model EmployeeTrackingSystem.Models.DashboardTablesViewModel


    <div id="tables-container" class="tables-container d-flex flex-wrap">
        <!-- Table 1–2–9 -->
        <div class="col-md-3 col-sm-12 tb1">@Html.Partial("_DashboardTable", Model.Table1)</div>
        <div class="col-md-6 col-sm-12 tb2">@Html.Partial("_DashboardTable5Col", Model.Table2)</div>
        <div class="col-md-3 col-sm-12 tb9">@Html.Partial("_DashboardTable", Model.Table9)</div>

        <!-- Table 3–7–10 -->
        <div class="col-md-3 col-sm-12 tb3">@Html.Partial("_DashboardTable", Model.Table3)</div>
        <div class="col-md-6 col-sm-12 tb4">@Html.Partial("_DashboardTable5Col", Model.Table7)</div>
        <div class="col-md-3 col-sm-12 tb10">@Html.Partial("_DashboardTable", Model.Table10)</div>

        <!-- Table 6–4–5–11 -->
        <div class="col-md-3 col-sm-12 tb5">@Html.Partial("_DashboardTable", Model.Table6)</div>
        @*<div class="col-md-3 col-sm-12 tb6">@Html.Partial("_DashboardTable", Model.Table4)</div>
            <div class="col-md-3 col-sm-12 tb7">@Html.Partial("_DashboardTable", Model.Table5)</div>*@
        <div class="col-md-6 col-sm-12 tb6">
            @*capital & tennic tokyo*@
            <div class="row no-gap">
                <div class="col-md-6 col-sm-12">
                    @Html.Partial("_DashboardTable", Model.Table4)
                </div>
                <div class="col-md-6 col-sm-12">
                    @Html.Partial("_DashboardTable", Model.Table5)
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-12 tb11">@Html.Partial("_DashboardTable", Model.Table11)</div>

    </div>
</div>


@*staffname click popup*@
<div class="modal fade" id="staffModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="staffForm">
                <input type="hidden" id="StaffCd" name="StaffCd" />
                <input type="hidden" id="DepartmentCd" name="DepartmentCd" />
                <div class="modal-header">
                    <h5 class="modal-title">Data入力 &nbsp;&nbsp;&nbsp;—&nbsp;&nbsp;&nbsp; <span id="staffName"></span></h5>
                </div>

                <div class="modal-body">
                    <!-- 在席 -->
                    <div class="form-group">
                        <label><input type="radio" name="Status" value="在席" /> 在席</label>
                        <div id="shop-options" class="shop-options" style="display:none;">
                            @foreach (var shop in Model.AvailableShops)
                            {
                                <label><input type="radio" name="Shop" value=@shop.DepartmentCD /> @shop.DepartmentName</label>
                            }
                        </div>
                    </div>
                    <!-- 帰宅 -->
                    <div class="form-group">
                        <label><input type="radio" name="Status" value="帰宅" /> 帰宅</label>

                    </div>

                    <!-- 外出 -->
                    <div class="form-group status-option">
                        <label class="status-label"><input type="radio" name="Status" value="外出" /> 外出</label>
                        <div class='input-group date' id='datetimepicker-out'>
                            <input type='text' name="ReturnDateTime-out" class="form-control" placeholder="ReturnDateTime" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                        <input type="text" id="Note-out" name="Note-out" class="form-control status-input" placeholder="Note" maxlength="200" />
                    </div>
                    <!-- 会議 -->
                    <div class="form-group status-option">
                        <label class="status-label"><input type="radio" name="Status" value="会議" /> 会議</label>
                        <div class='input-group date' id='datetimepicker-meeting'>
                            <input type='text' name="ReturnDateTime-meeting" class="form-control" placeholder="ReturnDateTime" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                        <input type="text" id="Note-meeting" name="Note-meeting" class="form-control status-input" placeholder="Note" maxlength="200" />
                    </div>
                    <!-- 休み -->
                    <div class="form-group status-option">
                        <label class="status-label"><input type="radio" name="Status" value="休み" /> 休み</label>
                        <input type="text" id="Note-leave" style="width:100% !important" name="Note-leave" class="form-control status-input" placeholder="Note" maxlength="200" />
                    </div>
                    <!-- 直行 -->
                    <div class="form-group status-option">
                        <label class="status-label"><input type="radio" name="Status" value="直行" /> 直行</label>
                        <div class='input-group date' id='datetimepicker-visit'>
                            <input type='text' name="ReturnDateTime-visit" class="form-control" placeholder="ReturnDateTime" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                        <input type="text" id="Note-visit" name="Note-visit" class="form-control status-input" placeholder="Note" maxlength="200" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary">登録</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*searchicon click popup*@
<div class="modal fade" id="searchModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <!-- wider for table layout -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    予定明細 &nbsp;&nbsp;&nbsp;—&nbsp;&nbsp;&nbsp;
                    <span id="displayStaffName"></span>
                </h5>
            </div>

            <div class="modal-body">
                <div class="schedule-panel">
                    <input type="hidden" id="hdnStaffId" />
                    <!-- Status -->
                    <div class="radio-group">
                        <label><input type="radio" name="lblst" value="外出"> 外出</label>
                        <label><input type="radio" name="lblst" value="会議"> 会議</label>
                        <label><input type="radio" name="lblst" value="休み"> 休み</label>
                        <label><input type="radio" name="lblst" value="直行"> 直行</label>
                    </div>

                    <!-- Input Row -->
                    <div class="form-group status-option">
                        <div class='input-group date' id='datetimepicker-plan'>
                            <input type='text' name="PlanDateTime" id="PlanDateTime" class="form-control" placeholder="計画日時" autocomplete="off" required />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                        <div class='input-group date' id='datetimepicker-return'>
                            <input type='text' name="PlanReturnDateTime" id="PlanReturnDateTime" class="form-control" placeholder="帰還日時" autocomplete="off" required />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                    </div>


                    <!-- Note -->
                    <div class="note-add-row">
                        <input type="text"
                               id="txtnote"
                               class="form-control"
                               placeholder="備考" maxlength="200"
                               autocomplete="off"
                               required>

                        <button type="button"
                                id="btnPlan"
                                class="btn btn-primary">
                            追加
                        </button>
                    </div>

                </div>
                <div class="modal-container">
                    <!-- Table -->

                    <table class="table table-bordered" id="Plantable">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" id="chkAll" />
                                </th>
                                <th>状態</th>
                                <th>計画日時</th>
                                <th>帰還日時</th>
                                <th>備考</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                <button type="button" id="btnSavePlan" class="btn btn-primary">登録</button>
                <button type="button" id="btnDelPlan" class="btn btn-danger">削除</button> @*20260611*@
            </div>
        </div>
    </div>
</div>

<!-- Success Message Box -->
<div id="successBox" class="message-box hidden">
    <div class="message-header">成功!</div>
    <div class="message-body" id="successMessage"></div>
    <button class="message-button" onclick="closeSuccessBox()">はい</button>
</div>

<!-- Error Message Box -->
<div id="errorBox" class="message-box hidden">
    <div class="message-header error">エラー!</div>
    <div class="message-body" id="errorMessage"></div>
    <button class="message-button error" onclick="closeErrorBox()">はい</button>
</div>
<!-- Confirm Message Box //20260611 -->
<div id="confirmBox" class="message-box hidden">
    <div class="message-header">確認</div>
    <div class="message-body" id="confirmMessage">
        削除してもよろしいですか？
    </div>
    <button class="message-button" onclick="confirmYes()">はい</button>
    <button class="message-button" onclick="closeConfirmBox()">いいえ</button>
</div>

@section Scripts {

    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        let draggedItem = null;
        let targetItem = null;
        let staffdrop = null;
        var focusField = "";
    $(document).ready(function () {
        // Restore saved value from sessionStorage
        var savedDept = sessionStorage.getItem("selectedDept");
        if (savedDept) {
            $("#departmentDropdown").val(savedDept);
        }
        // Initial load
        filterDepartment();

        $("#departmentDropdown").change(function (event) {
                event.preventDefault();
                filterDepartment();
            });

        $(window).resize(function () {
                filterDepartment();
            });

            $(document).on("click", ".staff-link", function () {
                // Clear all inputs in the modal form
                $("#staffForm")[0].reset();
                // Also clear hidden fields explicitly
                $("#StaffCd").val("");
                $("#DepartmentCd").val("");

                $("#StaffCd").val($(this).data("sid")); // staffcd from link
                $("#DepartmentCd").val($(this).data("did")); // DepartmentCD from link

                // 2. Insert the name into the span inside the modal
                $('#staffName').text($(this).data('staffname'));

                // Radio button (Status)
                var status = $(this).data("status");
                $("input[name='Status'][value='" + status + "']").prop("checked", true);

                var returnDate = $(this).data("returndatetime");
                var note = $(this).data("note");

                const date = new Date(returnDate);

                const formatted = date.toLocaleString('en-CA', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                }).replace(',', '').replace(/-/g, '-');

                // Disable all ReturnDateTime and Note inputs by default
                $("input[name^='ReturnDateTime']").prop("disabled", true).val("");
                $("input[id^='Note']").prop("disabled", true).val("");

                if (status === "外出") {
                    $("input[name='ReturnDateTime-out']").prop("disabled", false).val(formatted);
                    $("input[name='Note-out']").prop("disabled", false).val(note);
                } else if (status === "会議") {
                    $("input[name='ReturnDateTime-meeting']").prop("disabled", false).val(formatted);
                    $("input[name='Note-meeting']").prop("disabled", false).val(note);
                } else if (status === "休み") {
                    $("input[name='Note-leave']").prop("disabled", false).val(note);
                } else if (status === "直行") {
                    $("input[name='ReturnDateTime-visit']").prop("disabled", false).val(formatted);
                    $("input[name='Note-visit']").prop("disabled", false).val(note);
                }
                // Show Shop radios only for Shop01, Shop02, Shop03 departments
                var dept = $(this).data("did").toString(); // Ensure it is a string
                if (dept.startsWith('S')) {
                    $("#shop-options").show();
                    $("input[name='Shop'][value='" + dept + "']").prop("checked", true);
                } else {
                    $("#shop-options").hide();
                }
            });
            $(function () {
                $('#datetimepicker-out').datetimepicker({
                    format: 'YYYY-MM-DD HH:mm',
                    showClear: true,
                    showClose: true,
                    minDate: moment().startOf('day'),
                    widgetPositioning: {
                        horizontal: 'left',
                        vertical: 'bottom'
                    }
                });

                $('#datetimepicker-meeting').datetimepicker({
                    format: 'YYYY-MM-DD HH:mm',
                    showClear: true,
                    showClose: true,
                    minDate: moment().startOf('day')
                });

                $('#datetimepicker-visit').datetimepicker({
                    format: 'YYYY-MM-DD HH:mm',
                    showClear: true,
                    showClose: true,
                    minDate: moment().startOf('day')
                });
                //20260616
                $('#datetimepicker-plan').datetimepicker({
                    format: 'YYYY-MM-DD HH:mm',
                    showClear: true,
                    showClose: true,
                    useCurrent: false,
                    minDate: moment().startOf('day'),
                    defaultDate: moment().startOf('day'), // 00:00
                    widgetPositioning: {
                        horizontal: 'left',
                        vertical: 'bottom'
                    }
                });

                //$('#datetimepicker-plan').on('change.datetimepicker', function (e) {
                //    if (e.date) {
                //        var date = e.date.clone().startOf('day');
                //        $(this).datetimepicker('date', date);
                //    }
                //});
                $('#datetimepicker-return').datetimepicker({
                    format: 'YYYY-MM-DD HH:mm',
                    showClear: true,
                    showClose: true,
                    minDate: moment().startOf('day'),
                    defaultDate: moment().startOf('day'), // 00:00
                    widgetPositioning: {
                        horizontal: 'left',
                        vertical: 'bottom'
                    }
                });
                //$('#datetimepicker-return').on('change.datetimepicker', function (e) {
                //    alert(e.date);
                //    if (e.date) {
                //        var date = e.date.clone().startOf('day');
                //        $(this).datetimepicker('date', date);
                //    }
                //});
            });
            // When staffModal is shown, initialize the datetimepicker
        $('#staffModal').on('shown.bs.modal', function (event) {

            
                var link = $(event.relatedTarget); // this is the <a class="staff-link"> you clicked
                // Status radio
                var status = link.data("status");
                $("input[name='Status'][value='" + status + "']").prop("checked", true);

                // Date + note
                var returnDate = link.attr("data-returndatetime");
                var note = link.data("note");

                var formatted = "";
                if (returnDate) {
                    var isoString = returnDate.replace(" ", "T");
                    var date = new Date(isoString);
                    if (!isNaN(date.getTime())) {
                        formatted = date.toLocaleString('en-CA', {
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit',
                            hour: '2-digit',
                            minute: '2-digit',
                            hour12: false
                        }).replace(',', '').replace(/-/g, '-');
                    }
                }

                if (status === "外出") {
                    $("#ReturnDateTime-out").prop("disabled", false).val(formatted);
                    $("#Note-out").prop("disabled", false).val(note);
                } else if (status === "会議") {
                    $("#ReturnDateTime-meeting").prop("disabled", false).val(formatted);
                    $("#Note-meeting").prop("disabled", false).val(note);
                } else if (status === "休み") {
                    $("#Note-leave").prop("disabled", false).val(note);
                } else if (status === "直行") {
                    $("#ReturnDateTime-visit").prop("disabled", false).val(formatted);
                    $("#Note-visit").prop("disabled", false).val(note);
                }
                var status = $("input[name='Status']:checked").val();

                // Clear all requirements first
                $("input[name^='ReturnDateTime']").prop("required", false).prop("disabled", true);
                $("#Note-out, #Note-meeting, #Note-leave, #Note-visit").prop("required", false).prop("disabled", true);

                // Enable + require based on status
                if (status === "外出") {
                    $("input[name='ReturnDateTime-out']").prop("disabled", false).prop("required", true);
                    $("#Note-out").prop("disabled", false).prop("required", true);
                } else if (status === "会議") {
                    $("input[name='ReturnDateTime-meeting']").prop("disabled", false).prop("required", true);
                    $("#Note-meeting").prop("disabled", false).prop("required", true);
                } else if (status === "休み") {
                    $("#Note-leave").prop("disabled", false).prop("required", true);
                } else if (status === "直行") {
                    $("input[name='ReturnDateTime-visit']").prop("disabled", false).prop("required", true);
                    $("#Note-visit").prop("disabled", false).prop("required", true);
                }
        });

        $('#datetimepicker-plan').on('dp.show', function () {

            $(this).data('DateTimePicker')
                .date(moment().startOf('day'));
        });

        $('#datetimepicker-return').on('dp.show', function () {

            $(this).data('DateTimePicker')
                .date(moment().startOf('day'));
        });

            $("#staffForm").on("submit", function (e) {
                // If invalid, let browser show its tooltip
                if (!this.checkValidity()) {
                    e.preventDefault(); // stop only if invalid
                    this.reportValidity(); // force tooltip display
                    return;
                }
                e.preventDefault();

                var status = $("input[name='Status']:checked").val();
                var currentShop = $("input[name='Shop']:checked").val();

                var returnDateTime = null;
                var note = null;

                if (status === "外出") {
                    returnDateTime = $("input[name='ReturnDateTime-out']").val();
                    note = $("#Note-out").val();
                } else if (status === "会議") {
                    returnDateTime = $("input[name='ReturnDateTime-meeting']").val();
                    note = $("#Note-meeting").val();
                } else if (status === "休み") {
                    note = $("#Note-leave").val();
                } else if (status === "直行") {
                    returnDateTime = $("input[name='ReturnDateTime-visit']").val();
                    note = $("#Note-visit").val();
                }

                var staffCD = $("#StaffCd").val();
                var departmentCD = $("#DepartmentCd").val();

                var payload = {
                    DepartmentCD: departmentCD,
                    StaffCd: staffCD,
                    Status: status,
                    ReturnDateTime: returnDateTime,
                    Note: note,
                    CurrentShop: currentShop
                };

                $.ajax({
                   url: '@Url.Action("SaveStaff", "Home")',
                    type: 'POST',
                    data: payload,
                    success: function (response) {
                        if (response.message === '登録しました。') {

                            $("#successMessage").text(response.message);
                            $("#successBox").removeClass("hidden");
                            $("#staffModal").modal("hide");
                        }
                        else {
                            $("#errorMessage").text(response.message);
                            $("#errorBox").removeClass("hidden");
                            $("#staffModal").modal("hide");
                        }
                        //location.reload();
                    },
                    error: function () {
                        $("#errorMessage").text("An error occurred while saving.");
                        $("#errorBox").removeClass("hidden");
                    }

                });
            });

            $(document).on("change", "input[name='Status']", function () {

                // Add required attributes based on selected radio
                var selected = $(this).val();

                // First clear and disable all ReturnDateTime and Note inputs
                $("input[name^='ReturnDateTime']").val("").prop("required", false).prop("disabled", true);
                $("input[id^='Note']").val("").prop("required", false).prop("disabled", true);

                // Enable only the inputs for the selected status
                if (selected === "外出") {
                    $("input[name='ReturnDateTime-out']").prop("disabled", false).prop("required", true);
                    $("#Note-out").prop("disabled", false).prop("required", true);
                } else if (selected === "会議") {
                    $("input[name='ReturnDateTime-meeting']").prop("disabled", false).prop("required", true);
                    $("#Note-meeting").prop("disabled", false).prop("required", true);
                } else if (selected === "休み") {
                    $("#Note-leave").prop("disabled", false).prop("required", true);
                } else if (selected === "直行") {
                    $("input[name='ReturnDateTime-visit']").prop("disabled", false).prop("required", true);
                    $("#Note-visit").prop("disabled", false).prop("required", true);
                }
            });

        //Searchar Icon click
        var editingRow = null;
        $('#searchModal').on('shown.bs.modal', function () {

            // Radio buttons
            $('input[name="lblst"]').prop('checked', false);
            $('input[name="lblst"][value="' + "外出" + '"]').prop('checked', true);

            $('input[name="PlanDateTime"]').val('');
            $('input[name="PlanReturnDateTime"]').val('');
            $('#txtnote').val('');
            editingRow = null;
        });

        $(document).on("click", ".search-icon", function () {
                var staffId = $(this).attr('id');

                $('#hdnStaffId').val(staffId);
                // Show the modal
                $("#searchModal").modal("show");
                //$('input[type="radio"]').first().prop('checked', true);

                var name = $(this).data('staffname');

                // 2. Insert the name into the span inside the modal
                $('#displayStaffName').text(name);

                $.ajax({
                    url: '@Url.Action("GetPlanData", "Home")',
                    type: 'POST',
                    dataType: 'json',
                    data: { id: staffId },
                    success: function (data) {
                        var jsonData = JSON.parse(data);
                        var rows = '';
                        $('#Plantable tbody').empty();
                        $.each(jsonData, function (i, item) {
                            rows += '<tr>'
                                + '<td>'
                                + '<input type="checkbox" class="chkRow" value="' + item.PlanID + '" />  <a href="#" class="editRow" data-id="' + item.PlanID +'"> <i class="fa fa-edit"></i> </a>'
                                + '</td>'
                                + '<td class="status">' + (item.Status) + '</td>'
                                + '<td class="planDate">' + formatDate(item.PlanDateTime) + '</td>'
                                + '<td class="returnDate">' + formatDate(item.ReturnDateTime) + '</td>'
                                + '<td class="remark">' + (item.Note) + '</td>'
                                + '</tr>';
                        });

                        $('#Plantable tbody').append(rows);
                    }
                });
            });

        $(document).on("click", "#btnSavePlan", function () {
                var list = [];
                //var selectedIds = [];
                $(".chkRow:checked").each(function () {
                   // selectedIds.push($(this).val());
                    var row = $(this).closest("tr");
                    list.push({
                        StaffCD: $('#hdnStaffId').val(), //20260612
                        Status: row.find(".status").text().trim(),
                        PlanDateTime: row.find(".planDate").text().trim(),
                        ReturnDateTime: row.find(".returnDate").text().trim(),
                        Note: row.find(".remark").text().trim(),
                        PlanID: row.find(".chkRow").val()
                    });
                });

                // Check at least one selected
                if (list.length === 0) {
                    $("#errorMessage").text("少なくとも1件のレコードを選択してください。");
                    $("#errorBox").removeClass("hidden");
                    return;
                }
                 // send to server
            $.ajax({
                url: '@Url.Action("SavePlanData", "Home")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(list),
                success: function (res) {
                    if (res.success)
                    {
                        $("#successMessage").text('登録しました。');
                        $("#successBox").removeClass("hidden");

                        $("#searchModal").modal("hide");
                    }
                    else {
                        $("#searchModal").modal("hide");
                    }
                }
            });
            })

        $(document).on('click', '.editRow', function () {
            $('#Plantable tbody tr').css('background-color', '');
            editingRow = $(this).closest('tr');
            var status = editingRow.find('.status').text().trim();
            var startDate = editingRow.find('.planDate').text().trim();
            var endDate = editingRow.find('.returnDate').text().trim();
            var remarks = editingRow.find('.remark').text().trim();

            $('input[name="lblst"][value="' + status + '"]').prop('checked', true);
            $('#PlanDateTime').val(startDate);
            $('#PlanReturnDateTime').val(endDate);
            $('#txtnote').val(remarks);
            editingRow.css('background-color', '#e9ecef');
        });

        $(document).on('click', '#btnPlan', function () {
            var staffId = $('#hdnStaffId').val();
            var statusflg = $('input[name="lblst"]:checked').val();
            var startDate = $('input[name="PlanDateTime"]').val();
            var endDate = $('input[name="PlanReturnDateTime"]').val();
            var note = $('#txtnote').val();
            if (!startDate) {
                $('input[name="PlanDateTime"]')[0].reportValidity();
                return;
            }
            if (!endDate) {
                $('input[name="PlanReturnDateTime"]')[0].reportValidity();
                return;
            }
            var start = moment(startDate, 'YYYY-MM-DD HH:mm').toDate();
            var end = moment(endDate, 'YYYY-MM-DD HH:mm').toDate();
            var now = new Date();

            if (start <= now) {
                focusField = "PlanDateTime";
                $("#errorMessage").text("計画日時は現在日時より後でなければなりません。");
                $("#errorBox").removeClass("hidden");
                return;
            }

            if (end <= start) {
                focusField = "PlanReturnDateTime";
                $("#errorMessage").text("帰社日時は計画日時より後の日時を入力してください");
                $("#errorBox").removeClass("hidden");
                return;
            }
            var hasOverlap = false;

            $('#Plantable tbody tr').each(function () {
                if (editingRow && $(this)[0] === editingRow[0]) {
                    return true; 
                }

                var existingStart = moment(
                    $(this).find('.planDate').text(),
                    'YYYY-MM-DD HH:mm'
                ).toDate();

                var existingEnd = moment(
                    $(this).find('.returnDate').text(),
                    'YYYY-MM-DD HH:mm'
                ).toDate();

                if (start < existingEnd && end > existingStart) {
                    hasOverlap = true;
                    return false;
                }
            });

            if (hasOverlap) {
                focusField = "PlanDateTime";
                $("#errorMessage").text("入力した日時は既存の計画と重複しています");
                $("#errorBox").removeClass("hidden");
                return;
            }
            if (editingRow) {

                // UPDATE EXISTING ROW
                editingRow.find('.status').text(statusflg);
                editingRow.find('.planDate').text(startDate);
                editingRow.find('.returnDate').text(endDate);
                editingRow.find('.remark').text(note);
                editingRow.find('.chkRow').prop('checked', true);
                editingRow = null;

            } else {
                var row = '<tr>'
                    + '<td>'
                    + '<input type="checkbox" class="chkRow" checked value=""> '
                    + '<a href="#" class="editRow" data-id="">'
                    + '<i class="fa fa-edit"></i></a>'
                    + '</td>'
                    + '<td class="status">' + statusflg + '</td>'
                    + '<td class="planDate">' + startDate + '</td>'
                    + '<td class="returnDate">' + endDate + '</td>'
                    + '<td class="remark">' + note + '</td>'
                    + '</tr>';

                $('#Plantable tbody').append(row);
            }

            // Clear inputs
            $('input[name="lblst"]').prop('checked', false);

            $('input[name="lblst"][value="' + "外出" + '"]').prop('checked', true);
            $('input[name="PlanDateTime"]').val('');
            $('input[name="PlanReturnDateTime"]').val('');
            $('#txtnote').val('');

        });

       

       document.addEventListener("mouseover", function (e) {
                // Check if the hovered element has our class
                if (e.target.classList.contains("nested-cell")) {
                    const el = e.target;

                    // If the actual text width is wider than the container
                    if (el.scrollWidth > el.clientWidth) {
                        // Set the title only for long strings
                        el.setAttribute("title", el.innerText);
                        el.style.cursor = "pointer";
                    } else {
                        // Remove title if it's a short string
                        el.removeAttribute("title");
                        el.style.cursor = "default";
                    }
                }
            });
            // drag and drop

