        function filterDepartment() {

        var screenWidth = $(window).width();
        var selectedDept = $("#departmentDropdown").val();

        // Mobile
        if (screenWidth < 990) {

            $(".department-area").hide();

            if (selectedDept === "") {
                $(".department-area").show();
            } else {
                $(".department-area").hide();

                if (selectedDept === 'S01' || selectedDept === 'S02' || selectedDept === 'S03') {
                    // Hide all shop first
                    $('#dept-container-S01, #dept-container-S02, #dept-container-S03').hide();

                    // Show all shop
                    $('#dept-container-S01, #dept-container-S02, #dept-container-S03').show();
                }
                else
                    $('#dept-container-' + selectedDept).show();

                // Optional: scroll to selected department
                //$('html, body').animate({
                //    scrollTop: $('#dept-container-' + selectedDept).offset().top - 10
                //}, 300);
            }
        }
        // Desktop
        else {
            $(".department-area").show();
            $('#departmentDropdown').val("");
        }
    }
